{
  "goal": "Find the score of Sousou no Frieren and write it to a file",
  "steps": [
    {
      "id": "s1",
      "tool": "search_anime",
      "args": {
        "query": "Sousou no Frieren"
      },
      "dependsOn": []
    },
    {
      "id": "s2",
      "tool": "writer",
      "args": {
        "path": "runs/${runId}/frieren.json",
        "content": "$s1.items"
      },
      "dependsOn": [
        "s1"
      ]
    }
  ]
}
